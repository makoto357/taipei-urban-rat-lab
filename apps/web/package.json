{
  "name": "@taipei-rat-lab/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm build:literature && vite",
    "build": "pnpm build:literature && tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test:e2e": "playwright test --config ../../tests/e2e/playwright.config.mts",
    "preview": "vite preview",
    "test": "node --import tsx --test tests/*.test.mjs",
    "build:literature": "tsx scripts/build-literature.mts"
  },
  "dependencies": {
    "@taipei-rat-lab/contracts": "workspace:*",
    "@taipei-rat-lab/ui": "workspace:*",
    "firebase": "^10.14.1",
    "maplibre-gl": "^6.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "sanitize-html": "2.13.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
