# Firebase Web App client config (public — safe to be visible in the browser bundle).
# This is NOT an authorization mechanism; real access control lives in Firestore/Storage
# Security Rules and Cloud Functions, per plan.md §8.
# Copy this file to .env.local and fill in real values with:
#   firebase apps:sdkconfig WEB <appId> --project <project-id>
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
