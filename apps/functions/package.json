{
  "name": "@taipei-rat-lab/functions",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22"
  },
  "main": "./lib/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=lib/index.js --alias:@taipei-rat-lab/contracts=../../packages/contracts/src/index.ts --external:firebase-admin --external:firebase-functions --external:sharp",
    "test": "vitest run",
    "test:integration": "vitest run --config ../../tests/integration/vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "firebase-admin": "^13.0.2",
    "firebase-functions": "^6.2.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
