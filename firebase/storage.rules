rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAllowedImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function isWithinUploadLimit() {
      return request.resource.size <= 8 * 1024 * 1024;
    }

    // Files are initially private. Functions validate and sanitize them before
    // any public derivative exists; public derivatives are not exposed here yet.
    match /staging/{uid}/{mediaId} {
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && isAllowedImage()
        && isWithinUploadLimit();
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
